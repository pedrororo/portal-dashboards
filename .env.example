DATABASE_URL=postgres://portal:portal@localhost:5433/portal
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
# Admin criado pelo seed
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# URL pública do portal (usada no e-mail de boas-vindas)
APP_URL=http://localhost:3000

# E-mail (opcional). Sem SMTP_HOST a senha temporária aparece na tela para o admin repassar.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Portal de Dashboards <nao-responda@exemplo.com>

# Metabase com embed assinado (opcional). Em Metabase: Admin > Embedding > Static embedding.
# METABASE_SITE_URL=https://metabase.exemplo.com
# METABASE_SECRET_KEY=
